# LLM (DeepSeek V4 Pro)
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-api-key
LLM_MODEL=deepseek-V4Pro

# Embedding (DeepSeek V4 Pro)
EMBEDDING_API_BASE=https://api.deepseek.com/v1
EMBEDDING_API_KEY=sk-your-deepseek-api-key
EMBEDDING_MODEL=deepseek-V4Pro

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5444/rag_kb

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads
