# ========================================================
# Noir AI — 环境变量配置模板
# 复制为 .env 后填入实际的 API Key
# cp .env.example .env
# ========================================================

# MySQL 数据库密码（默认 123456）
MYSQL_PASSWORD=123456

# ====== AI 模型 API Keys（至少配置一个）======

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# 通义千问 (阿里): https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-dashscope-key

# Moonshot (月之暗面): https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=sk-your-moonshot-key

# 智谱AI (GLM): https://open.bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=your-zhipu-key

# 零一万物: https://platform.lingyiwanwu.com/apikeys
YI_API_KEY=your-yi-key